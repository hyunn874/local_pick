# 앱 실행 환경
# development | preview | production
EXPO_PUBLIC_APP_ENV=development

# 실제 카카오 로그인 버튼 활성화 여부
# true면 카카오 인가코드를 받아 백엔드 /api/auth/kakao로 전달합니다
EXPO_PUBLIC_ENABLE_KAKAO_LOGIN=false

# 카카오 REST API 키 – OAuth 로그인과 거주자 인증 Reverse Geocoding에 사용
EXPO_PUBLIC_KAKAO_REST_API_KEY=your_kakao_rest_api_key
# Redirect URI – 카카오 개발자 콘솔에 등록한 URI와 반드시 일치해야 합니다
# 기본값은 app.json의 expo.extra.kakao.redirectUri에 이미 설정되어 있습니다
# EXPO_PUBLIC_KAKAO_REDIRECT_URI=localpick://auth/kakao

# 네이버 지도 Dynamic Map Client ID
EXPO_PUBLIC_NAVER_MAP_CLIENT_ID=your_naver_map_client_id

# 백엔드 API 주소
# 비워두면 Render 배포 서버를 사용합니다.
# EXPO_PUBLIC_API_BASE_URL=https://localpick-api.onrender.com
