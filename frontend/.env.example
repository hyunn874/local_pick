# 카카오 Native App 키 – 네이티브 SDK 로그인에 사용 (@react-native-seoul/kakao-login)
EXPO_PUBLIC_KAKAO_NATIVE_APP_KEY=your_kakao_native_app_key

# 카카오 REST API 키 – OAuth 로그인에 사용 (kakaoAuthApi.js)
EXPO_PUBLIC_KAKAO_REST_API_KEY=your_kakao_rest_api_key

# 카카오 JavaScript 키 – 지도 WebView에 사용 (KakaoMapView.js)
EXPO_PUBLIC_KAKAO_JAVASCRIPT_KEY=your_kakao_javascript_key

# Redirect URI – 카카오 개발자 콘솔에 등록한 URI와 반드시 일치해야 합니다
# 기본값은 app.json의 expo.extra.kakao.redirectUri에 이미 설정되어 있습니다
# EXPO_PUBLIC_KAKAO_REDIRECT_URI=localpick://auth/kakao

# 백엔드 API Base URL – iOS 시뮬레이터 기준
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080

# 지역 목록 API 경로 – 기본값은 /api/regions 입니다
# EXPO_PUBLIC_REGIONS_ENDPOINT=/api/regions
